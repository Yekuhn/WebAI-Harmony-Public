{
  "manifest_version": 3,
  "name": "ChatGPT Tab Bridge",
  "version": "0.6.5",
  "description": "Connects ChatGPT tabs to a local Python bridge with canonical JSON artifacts, verified multiple-download permission, exact download tracking, cleanup, and diagnostics.",
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "contentSettings",
    "webRequest"
  ]
}
